# Email configuration — feedback notifications and admin password recovery OTP
# Configure with your SMTP provider (e.g., Gmail, SendGrid, Mailgun, etc.)
# EMAIL_PROVIDER: "auto" (default) uses SMTP when credentials are set and falls
# back to mock mode (OTP written to the server log) when they are empty.
# Force with EMAIL_PROVIDER=smtp or EMAIL_PROVIDER=mock.
EMAIL_PROVIDER=auto
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=chairococaine@gmail.com
EMAIL_PASS=eryv wkgu nrow txwt
EMAIL_FROM=chairococaine@gmail.com
EMAIL_TO=chairococaine@gmail.com


